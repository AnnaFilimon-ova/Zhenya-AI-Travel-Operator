# Скопируй в .env (cp .env.example .env) и при необходимости заполни.
# Файл .env не коммитится в репозиторий.

# --- Telegram (необязательно: без токена бот не запускается, веб-версия работает) ---
# Токен бота от @BotFather
BOT_TOKEN=
# Публичный https-адрес мини-аппа для кнопки в Telegram (например, от ngrok). Локально можно оставить пустым.
WEBAPP_URL=

# --- ИИ ---
# Ключ Gemini из https://aistudio.google.com/apikey (без него агент не отвечает)
GEMINI_API_KEY=

# --- Оплата (необязательно) ---
# Тестовый токен ЮKassa из BotFather (Payments), вида 123456789:TEST:123456. Если пусто, оплата имитируется.
PAYMENT_PROVIDER_TOKEN=

# --- Демо-режим для браузера ---
# Вход гостем без Telegram: все запросы с http://localhost:8080 идут от пользователя с этим id.
# В продакшене удалить эту строку.
DEV_USER_ID=1

# --- База данных ---
# В Docker адрес базы подставляется сам. Эта строка нужна только для запуска без Docker.
DATABASE_URL=postgresql+asyncpg://postgres:zhenya@localhost:5432/zhenya_db
# Пароль Postgres в Docker (по умолчанию zhenya)
POSTGRES_PASSWORD=zhenya
